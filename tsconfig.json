{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "api/**/*.ts",
    "config/**/*.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "test-data/**/*.ts",
    "tests/**/*.ts"
  ]
}
