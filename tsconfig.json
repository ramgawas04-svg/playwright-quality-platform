{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "playwright*.config.ts",
    "api/**/*.ts",
    "config/**/*.ts",
    "diagnostics/**/*.ts",
    "examples/**/*.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "test-data/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts"
  ]
}
